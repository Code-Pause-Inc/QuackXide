# ─────────────────────────────────────────────────────────────────────────────
# Backend runtime configuration. Copy to .env for local dev (gitignored).
#
# Every customer-facing name and domain is configuration; the engine name
# never appears in a customer-facing surface.
# ─────────────────────────────────────────────────────────────────────────────

# ── Brand / white-label ──────────────────────────────────────────────────────
APP_PUBLIC_NAME="Confidential Drive"
APP_DOMAIN_NAME="drive.yourdomain.example"
APP_SUPPORT_EMAIL="support@yourdomain.example"

# ── HTTP server ──────────────────────────────────────────────────────────────
BIND_ADDR="127.0.0.1:8080"
# Prometheus metrics for a scraper on this host. Loopback only.
METRICS_BIND_ADDR="127.0.0.1:9464"
# Structured JSON logs; SECURITY_AUDIT_EVENT records are emitted at info level.
RUST_LOG="info"

# ── Google Cloud Storage vault ───────────────────────────────────────────────
GCP_PROJECT_ID=""
STORAGE_BUCKET=""
# Optional local GCS emulator URL (e.g. "http://fake-gcs:4443" in
# docker-compose.simulated-tee.yml). When set, ObjectStoreVault::new_gcs
# routes requests to the emulator without OAuth token signing.
# STORAGE_EMULATOR_HOST=""
# Storage client limits. A storage call that stalls fails after at most
# retry timeout + min(5, retry timeout) + request timeout seconds (55 with
# these defaults), and the API answers 503 with Retry-After.
# STORAGE_REQUEST_TIMEOUT_SECS="30"   # one request, 1-300
# STORAGE_CONNECT_TIMEOUT_SECS="5"    # 1-60, at most the request timeout
# STORAGE_MAX_RETRIES="3"             # 0-10; 5xx, 429, timeouts, connection errors
# STORAGE_RETRY_TIMEOUT_SECS="20"     # 0-240; no retry starts after this

# ── Feature toggles ──────────────────────────────────────────────────────────
# Aggregate-only query gate with cohort suppression. Defaults to "true" when
# unset; "false" allows row-level queries and breaks the no-naked-data
# invariant.
FEATURE_ZK_ENABLED="true"
# Pipelines refuse to run outside an attested SEV-SNP enclave. Defaults to
# "true" when unset; this template sets "false" for local development only.
TEE_ATTESTATION_REQUIRED="false"
# Base URL of the simulated TEE's key-release stand-in (`bin/key-release`).
# Dev only: a build without the `dev` feature refuses to start when it is set.
# When unset, `/api/v1/query` and `/api/v1/research/query` fail closed with 503.
KEY_RELEASE_URL=""
# Maximum concurrent queries holding decrypted data in enclave memory (1..=64).
QUERY_MAX_CONCURRENT="4"

# ── Simulated SEV-SNP TEE (local Docker / CI only; rejected when TEE_ATTESTATION_REQUIRED=true)
# Shared seed so `enclave-api` and `key-release-service` derive the same
# synthetic ARK -> ASK -> VCEK P-384 root of trust across containers.
# SIMULATED_SNP_SEED="quackxide-local-simulated-tee-seed-v1"
# Optional 96-hex-char (48-byte) override for SnpReport.measurement (tamper test).
# SIMULATED_SNP_MEASUREMENT_HEX=""
# Optional boolean ("true"/"false") to set GuestPolicy::DEBUG=1 (tamper test).
# SIMULATED_SNP_DEBUG="false"
# Optional 64-hex-char (32-byte) config digest bound into REPORT_DATA[32..64].
# ENCLAVE_CONFIG_DIGEST_HEX=""

# ── Connector sync worker ────────────────────────────────────────────────────
# Background sync cadence (seconds).
CONNECTOR_SYNC_INTERVAL_SECS="900"

# ── Research access (disclosure control) ─────────────────────────────────────
# Result rows whose cohort (COUNT(*) AS n) is below this are suppressed
# before egress. 11 is a common small-cell threshold for health statistics.
RESEARCH_MIN_COHORT_SIZE="11"
# Query units for a new dataset grant when the steward sets none. Budgets
# bound adaptive (differencing) querying and are raised by top-up, never reset.
RESEARCH_DEFAULT_QUERY_BUDGET="100"
# ISO 4217 display currency for catalog prices (stored in integer cents).
RESEARCH_PRICING_CURRENCY="USD"

# ── Connector worker demo ────────────────────────────────────────────────────
# Tenant id and enrolled public key for fixture syncs. Unset: an ephemeral
# key whose ciphertext nobody can open.
# DEMO_TENANT_ID=""
# DEMO_TENANT_PUBLIC_KEY_B64=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# Shared secret for dev/self-hosted HS256 tokens (generate: openssl rand -hex 32).
# When unset, drive routes fail closed with 503. Production uses RS256/JWKS
# (see platform-auth).
JWT_HS256_SECRET=""
# Defaults shown; internal identifiers, safe to leave as-is.
JWT_ISSUER="urn:platform:auth"
JWT_AUDIENCE="urn:platform:drive"

# ── Billing / Merchant of Record webhooks (Paddle) ───────────────────────────
# Paddle notification-destination secret (dashboard → Notifications). When
# unset, the webhook endpoint refuses with 503.
MOR_WEBHOOK_SECRET=""
# Replay-guard freshness window for the Paddle-Signature timestamp (seconds).
MOR_SIGNATURE_TOLERANCE_SECS="300"
