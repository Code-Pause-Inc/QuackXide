{
  "name": "platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run typecheck && vite build --mode release",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit && node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project node --project dom",
    "test:browser": "vitest run --project 'browser*'",
    "bench:seal": "vitest run --project seal",
    "bench:browser": "vitest bench --project 'browser*' --reporter=default --reporter=json --outputFile.json=.vitest/bench.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hpke/core": "1.10.1",
    "@hpke/hybridkem-x-wing": "0.7.1",
    "@noble/post-quantum": "0.7.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.1.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
