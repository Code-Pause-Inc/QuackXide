# Frontend configuration (copy to .env for local dev). Only VITE_-prefixed
# variables reach the browser bundle, so never put secrets here.

# Customer-facing branding; deployments are white-labeled.
VITE_APP_PUBLIC_NAME="Confidential Drive"
VITE_APP_DOMAIN_NAME="drive.yourdomain.example"
VITE_APP_SUPPORT_EMAIL="support@yourdomain.example"

# Backend API origin. Leave empty to call the page's own origin: in
# development the Vite dev server proxies /api, /admin and /healthz to
# API_PROXY_TARGET, so the browser makes no cross-origin requests. Set a full
# origin only when the API is served elsewhere and allows this origin (CORS).
VITE_API_BASE_URL=""

# Dev server only (no VITE_ prefix, never in the bundle): where the proxy
# forwards API requests. Defaults to http://127.0.0.1:8080.
# API_PROXY_TARGET="http://127.0.0.1:8080"

# Default visibility of zero-knowledge features in the UI.
VITE_FEATURE_ZK_ENABLED="false"

# Vault backend: "local" (IndexedDB, offline demo) or "http" (drive API).
VITE_VAULT_MODE="local"
# DEV ONLY, for http mode: token from `cargo run -p platform-api --bin devtoken`.
# Never put production credentials here.
VITE_DEV_JWT=""

# DEV ONLY: admin JWT (with the admin claim) to prefill the Admin console.
# Leave empty to paste a token into the console instead.
VITE_ADMIN_JWT=""
